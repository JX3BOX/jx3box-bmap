{
    "name": "@jx3box/jx3box-bmap",
    "version": "1.0.4",
    "description": "JX3BOX Baizhan Map",
    "scripts": {
        "dev": "env DEV_SERVER=true vue-cli-service serve",
        "serve": "vue-cli-service serve",
        "build": "vue-cli-service build",
        "lint": "vue-cli-service lint",
        "inspect": "vue inspect > output.js",
        "update": "npm --registry https://registry.npmjs.org install @jx3box/jx3box-common@latest"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@jx3box/jx3box-common": "^9.2.1",
        "axios": "^0.19.2",
        "element-plus": "^2.13.5",
        "html2canvas": "^1.4.1",
        "lodash": "^4.17.15",
        "vue": "^3.4.38",
        "vuex": "^4.1.0"
    },
    "devDependencies": {
        "@babel/compat-data": "^7.10.1",
        "@babel/eslint-parser": "^7.24.8",
        "@babel/plugin-proposal-optional-chaining": "^7.14.5",
        "@vue/cli-plugin-babel": "^5.0.9",
        "@vue/cli-plugin-eslint": "^5.0.9",
        "@vue/cli-plugin-router": "^5.0.9",
        "@vue/cli-plugin-vuex": "^5.0.9",
        "@vue/cli-service": "^5.0.9",
        "@vue/compiler-sfc": "^3.4.38",
        "core-js": "^3.4.3",
        "csslab": "^4.0.3",
        "eslint": "^8.57.0",
        "eslint-plugin-vue": "^9.26.0",
        "glob": "^7.1.6",
        "husky": "^7.0.4",
        "less": "^3.0.4",
        "less-loader": "^5.0.0",
        "style-resources-loader": "^1.3.3",
        "vue-svg-inline-loader": "^1.4.6"
    },
    "eslintConfig": {
        "root": true,
        "env": {
            "node": true
        },
        "extends": [
            "plugin:vue/essential"
        ],
        "rules": {},
        "parserOptions": {
            "parser": "@babel/eslint-parser",
            "requireConfigFile": false
        }
    },
    "browserslist": [
        "> 1%",
        "last 2 versions"
    ],
    "lint-staged": {
        "*.{js,vue}": [
            "prettier-eslint --write",
            "eslint --fix --max-warnings=0 --no-ignore",
            "git add"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "pre-push": "npm run test:unit"
        }
    },
    "overrides": {
        "vue-loader": "17.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JX3BOX/jx3box-bmap.git"
    }
}
